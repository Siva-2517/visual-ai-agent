# ============================================================
# Visual AI Browser Activity Agent — Environment Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Database Connection (Supabase Transaction Pooler URI) ---
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Redis Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Security Keys ---
SECRET_KEY=change-this-to-a-secure-random-string-in-production
EXTENSION_API_KEY=dev_api_key_visual_agent_2026_abc123def456ghi789jkl012mno345pqr

# --- Screenshot Storage ---
SCREENSHOTS_DIR=./storage/screenshots

# --- Tier 2 VLM Provider API Keys (Free Tier) ---
# 1. Google Gemini 2.5 Flash (Primary) -> Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq Llama Vision (Fallback)      -> Get key: https://console.groq.com/keys
GROQ_API_KEY=
